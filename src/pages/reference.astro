---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { ScalarComponent } from "@scalar/astro";

import { ENV } from "../constants";

const apiServer = ENV.APPAPI_URL;
---

<StarlightPage
  frontmatter={{
    title: "",
    template: "splash",
    // La referencia no navega como un doc: sin botones prev/next.
    prev: false,
    next: false,
  }}
  hasSidebar={false}
>
  <ScalarComponent
    renderMode="client"
    configuration={{
      sources: [{ url: "/openapi.json", agent: { disabled: true } }],
      servers: apiServer ? [{ url: apiServer }] : undefined,
      hideDarkModeToggle: true,
      theme: "saturn", 
      layout: "classic", 
      defaultOpenAllTags: true,
      searchHotKey: 'l'
    }}
  />
</StarlightPage>

<style is:global>
  /* Solo la referencia Scalar: fuera la franja del título vacío y el ancho
   * máximo del contenedor de Starlight (Scalar necesita todo el viewport). */
  .content-panel:has(> .sl-container > #_top) {
    display: none;
  }

  .content-panel:has(.scalar-app) {
    padding: 0;
  }

  .content-panel:has(.scalar-app) > .sl-container {
    max-width: none;
  }
</style>
